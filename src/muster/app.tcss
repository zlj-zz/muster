/* ================================================================
   muster TCSS — Activity Bar Layout
   ================================================================ */

Screen {
    background: #282c34;
    layout: vertical;
    overflow-y: hidden;
    overflow-x: hidden;
}

#main {
    layout: vertical;
    height: 1fr;
    min-height: 0;
    overflow: hidden;
}

#body {
    layout: horizontal;
    height: 1fr;
    min-height: 0;
    overflow: hidden;
}

/* ========== Content Switchers ========== */
ContentSwitcher {
    width: 100%;
    height: 1fr;
    min-height: 0;
    overflow: hidden;
}

/* ========== Left Panel ========== */
#left-content {
    width: 38;
    height: 1fr;
    min-height: 0;
    border-right: solid #3e4451;
}

#left-svc, #left-env, #left-yaml {
    width: 100%;
    height: 1fr;
    min-height: 0;
    overflow: hidden;
}

#left-svc {
    layout: vertical;
}

/* ========== Right Panel ========== */
#right-content {
    width: 1fr;
    height: 1fr;
}

#right-svc, #right-env, #right-yaml {
    width: 100%;
    height: 1fr;
    min-height: 0;
    overflow: hidden;
}

/* svc tab: detail + log split */
#right-svc {
    layout: vertical;
}

#right-svc DetailPanel {
    height: 38%;
    border-bottom: solid #3e4451;
}

#right-svc LogPanel {
    height: 1fr;
}

/* ========== Service Tree ========== */
#service-tree {
    width: 100%;
    height: 1fr;
    border: none;
    background: transparent;
    padding: 0 1;
}

Tree {
    background: transparent;
    padding: 0 1;
}

Tree > .tree--cursor {
    background: #264f78;
    text-style: bold;
    color: #ffffff;
}

Tree > .tree--highlight {
    text-style: none;
}

.tree--guides {
    color: #2c313c;
}

/* ========== Env Indicator ========== */
#env-indicator {
    width: 100%;
    height: 1;
    background: #2c313c;
    color: #858585;
    padding: 0 1;
    content-align: left middle;
    border-top: solid #3e4451;
}

/* ========== Detail Panel ========== */
#detail {
    height: 1fr;
    border: none;
    background: #2c313c;
    padding: 0;
    overflow: hidden;
}

#detail-container {
    height: 1fr;
    min-height: 0;
    layout: vertical;
    overflow: hidden;
}

#detail-top {
    height: 1fr;
    min-height: 0;
    overflow: hidden;
}

#detail-meta {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

#detail-resources {
    width: 28;
    height: auto;
    padding: 0 1;
    border-left: solid #3e4451;
}

.detail-row {
    height: auto;
    margin: 0;
}

.detail-key {
    width: 10;
    color: #5c6370;
    text-style: bold;
}

.detail-value {
    width: 1fr;
    color: #abb2bf;
}

#detail-command {
    height: auto;
    padding: 0 1;
    margin-top: 1;
    background: transparent;
    border: none;
}

#detail-command CollapsibleTitle {
    height: auto;
    color: #abb2bf;
    text-style: bold;
    padding: 0;
    background: transparent;
}

#detail-command Contents {
    height: auto;
    background: transparent;
    border: none;
    padding: 0;
}

.resource-row {
    height: auto;
    margin: 0;
}

.resource-label {
    width: 4;
    color: #5c6370;
    text-style: bold;
}

.resource-value {
    width: 1fr;
    color: #abb2bf;
}

.detail-section-title {
    height: auto;
    color: #abb2bf;
    text-style: bold;
    margin-bottom: 1;
}

.detail-code {
    height: auto;
    background: #282c34;
    padding: 0 1;
    margin-top: 0;
}

/* action buttons (detail panel + settings panel) */
#action-buttons, #settings-actions {
    height: auto;
    padding: 0 1;
    border-top: solid #3e4451;
    background: #2c313c;
}

#action-buttons Button, #settings-actions Button {
    width: auto;
    margin: 0 1 0 0;
    padding: 0;
    content-align: center middle;
}

#action-buttons Button.-style-flat.-success,
#settings-actions Button.-style-flat.-success {
    background: #98c379;
    border: block #98c379;
    color: #1e2227;
}
#action-buttons Button.-style-flat.-success:hover,
#settings-actions Button.-style-flat.-success:hover {
    background: #a5d48a;
    border: block #a5d48a;
}

#action-buttons Button.-style-flat.-error,
#settings-actions Button.-style-flat.-error {
    background: #e06c75;
    border: block #e06c75;
    color: #1e2227;
}
#action-buttons Button.-style-flat.-error:hover,
#settings-actions Button.-style-flat.-error:hover {
    background: #ec8088;
    border: block #ec8088;
}

#action-buttons Button.-style-flat.-warning,
#settings-actions Button.-style-flat.-warning {
    background: #e5c07b;
    border: block #e5c07b;
    color: #1e2227;
}
#action-buttons Button.-style-flat.-warning:hover,
#settings-actions Button.-style-flat.-warning:hover {
    background: #efd08f;
    border: block #efd08f;
}

#action-buttons Button:disabled,
#settings-actions Button:disabled {
    background: #252830;
    border: block #252830;
    color: #5c6370;
    text-opacity: 1.0;
}

/* ========== Log Panel ========== */
#log {
    height: 1fr;
    border: none;
    background: #323842;
    padding: 1;
}

#log-level-row {
    height: 1;
    background: #282c34;
    padding: 0 1;
}

.log-level-btn {
    width: auto;
    color: #5c6370;
    content-align: center middle;
    padding: 0 1;
}

.log-level-btn:hover {
    color: #abb2bf;
    text-style: none;
}

.log-level-btn.active {
    color: #eab459;
    text-style: bold;
}

#log-search-row {
    height: 1;
    background: #eab459;
    padding: 0 1;
}

#log-search-prefix {
    width: auto;
    color: #1e2227;
    content-align: center middle;
}

#log-search {
    width: 1fr;
    height: 1;
    border: none;
    background: transparent;
    color: #1e2227;
    padding: 0;
}

#log-search:focus {
    border: none;
}

#log-search-count {
    width: auto;
    color: #1e2227;
    content-align: center middle;
}

#log-scroll {
    height: 1fr;
    border: none;
    background: transparent;
}

/* ========== Env Detail Panel ========== */
#env-detail {
    height: 1fr;
    border: none;
    background: #2c313c;
    padding: 1 2;
    overflow: hidden;
}

#env-detail-content {
    height: 1fr;
    overflow-y: auto;
}

#env-detail-meta {
    height: auto;
}

#env-detail-history {
    height: auto;
    margin-top: 1;
}

#env-detail-latency-stats {
    height: auto;
    margin-top: 1;
}

#env-detail-stats {
    height: auto;
    margin-top: 1;
}

/* ========== YAML Preview ========== */
#yaml-preview {
    height: 1fr;
    border: none;
    background: #323842;
    padding: 0;
    overflow: hidden;
}

#yaml-title {
    height: 1;
    padding: 0 1;
    background: #282c34;
    color: #abb2bf;
    content-align: left middle;
    border-bottom: solid #3e4451;
}

#yaml-text {
    height: 1fr;
    border: none;
    background: transparent;
    padding: 1;
}

/* ========== Scrollbar ========== */
/* Textual uses `scrollbar-color` and `scrollbar-background` properties
   on the PARENT container (Tree, TextArea, etc.), not on ScrollBar itself. */
Tree, TextArea, VerticalScroll, DataTable, RichLog {
    scrollbar-color: #7a8295;
    scrollbar-background: transparent;
    scrollbar-color-hover: #abb2bf;
    scrollbar-background-hover: transparent;
    scrollbar-color-active: #eab459;
    scrollbar-background-active: transparent;
}

/* footer bar */
#footer-bar {
    height: 3;
    background: #282c34;
    border-top: solid #3e4451;
    padding: 0 1;
}

#footer-keys {
    width: 1fr;
    content-align: left middle;
    color: #5c6370;
}

#footer-mode {
    width: auto;
    background: #3e4451;
    color: #abb2bf;
    padding: 0 2;
    border-left: thick #eab459;
    content-align: center middle;
}

/* ========== Settings Panel ========== */
#left-settings {
    width: 100%;
    height: 1fr;
    display: none;
}

#right-settings {
    width: 100%;
    height: 1fr;
    background: #2c313c;
    padding: 1 2;
}

.settings-section {
    height: auto;
    margin: 1 0;
    border-bottom: solid #3e4451;
    padding-bottom: 1;
}

.settings-section-title {
    color: #eab459;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

.settings-row {
    height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    content-align: left middle;
}

.settings-label {
    width: 18;
    height: 100%;
    color: #abb2bf;
    content-align: left middle;
}

.settings-unit {
    width: auto;
    height: 100%;
    color: #5c6370;
    content-align: left middle;
}

/* unify control backgrounds */
.settings-row Input {
    height: 100%;
    width: 80%;
    border: tall #282c34;
    background: #282c34;
    color: #abb2bf;
    padding: 0 1;
}

.settings-row Select {
    height: 100%;
    width: 80%;
    border: none;
    color: #abb2bf;
    padding: 0 0;
}

.settings-row SelectCurrent {
    background: #282c34;
    border: tall #282c34;
}

.settings-row Select:focus > SelectCurrent {
    border: tall #eab459;
    background-tint: transparent;
}

SelectOverlay {
    border: tall #3e4451;
    background: #282c34;
}

SelectOverlay > .option-list--option {
    padding: 0 1;
}

#right-settings Switch {
    height: 100%;
    border: none;
    background: transparent;
    padding: 0;
    content-align: left middle;
}

#right-settings Switch .switch--slider {
    color: #5c6370;
    background: #3e4451;
}

#right-settings Switch.-on .switch--slider {
    color: #98c379;
}

#settings-actions Button {
    margin: 0 1 0 0;
}
