/* ================================================================
   muster TCSS — Activity Bar Layout (Atom One Dark + Vibrant Orange)
   ================================================================ */

Screen {
    background: #282c34;
    layout: vertical;
    overflow-y: hidden;
    overflow-x: hidden;
}

#main {
    layout: vertical;
    height: 1fr;
    min-height: 0;
    overflow: hidden;
}

#body {
    layout: horizontal;
    height: 1fr;
    min-height: 0;
    overflow: hidden;
}

/* ========== Content Switchers ========== */
ContentSwitcher {
    width: 100%;
    height: 1fr;
    min-height: 0;
    overflow: hidden;
}

/* ========== Left Panel ========== */
#left-content {
    width: 38;
    height: 1fr;
    min-height: 0;
    border-right: solid #3e4451;
}

#left-svc, #left-env, #left-yaml {
    width: 100%;
    height: 1fr;
    min-height: 0;
    overflow: hidden;
}

#left-svc {
    layout: vertical;
}

/* ========== Right Panel ========== */
#right-content {
    width: 1fr;
    height: 1fr;
}

#right-svc, #right-env, #right-yaml {
    width: 100%;
    height: 1fr;
    min-height: 0;
    overflow: hidden;
}

/* svc tab: detail + log split */
#right-svc {
    layout: vertical;
}

#right-svc DetailPanel {
    height: 38%;
    border-bottom: solid #3e4451;
}

#right-svc LogPanel {
    height: 1fr;
}

/* ========== Service Tree ========== */
#service-tree {
    width: 100%;
    height: 1fr;
    border: none;
    background: transparent;
    padding: 0 1;
}

Tree {
    background: transparent;
    padding: 0 1;
}

Tree > .tree--cursor {
    background: #3e4451;
    text-style: bold;
    color: auto;
}

Tree > .tree--highlight {
    text-style: none;
}

.tree--guides {
    color: #2c313c;
}

/* ========== Env Indicator ========== */
#env-indicator {
    width: 100%;
    height: 1;
    background: #2c313c;
    color: #858585;
    padding: 0 1;
    content-align: left middle;
    border-top: solid #3e4451;
}

/* ========== Detail Panel ========== */
#detail {
    height: 1fr;
    border: none;
    background: #2c313c;
    padding: 0;
    overflow: hidden;
}

#detail-container {
    height: 1fr;
    min-height: 0;
    layout: vertical;
    overflow: hidden;
}

#detail-content {
    height: 1fr;
    border: none;
    background: transparent;
}

#detail-content .datatable--header {
    display: none;
}

#detail-content .datatable--cursor {
    background: transparent;
}

#detail-content .datatable--hover {
    background: transparent;
}

/* action buttons */
#action-buttons {
    height: auto;
    padding: 0 1;
    border-top: solid #3e4451;
    background: #2c313c;
}

#action-buttons Button {
    width: auto;
    margin: 0 1 0 0;
    padding: 0;
    content-align: center middle;
}

#action-buttons Button.-style-flat.-success {
    background: #4caf50;
    border: block #4caf50;
    color: #ffffff;
}
#action-buttons Button.-style-flat.-success:hover {
    background: #66bb6a;
    border: block #66bb6a;
}

#action-buttons Button.-style-flat.-error {
    background: #f44336;
    border: block #f44336;
    color: #ffffff;
}
#action-buttons Button.-style-flat.-error:hover {
    background: #ef5350;
    border: block #ef5350;
}

#action-buttons Button.-style-flat.-warning {
    background: #ff9800;
    border: block #ff9800;
    color: #ffffff;
}
#action-buttons Button.-style-flat.-warning:hover {
    background: #ffa726;
    border: block #ffa726;
}

#action-buttons Button:disabled {
    background: #252830;
    border: block #252830;
    color: #5c6370;
    text-opacity: 1.0;
}

/* ========== Log Panel ========== */
#log {
    height: 1fr;
    border: none;
    background: #323842;
    padding: 1;
}

TextArea {
    background: transparent;
    border: none;
}

TextArea:focus {
    border: none;
}

/* ========== Env Detail Panel ========== */
#env-detail {
    height: 1fr;
    border: none;
    background: #2c313c;
    padding: 1 2;
    overflow: hidden;
}

#env-detail-content {
    height: 1fr;
    overflow-y: auto;
}

/* ========== YAML Preview ========== */
#yaml-preview {
    height: 1fr;
    border: none;
    background: #323842;
    padding: 0;
    overflow: hidden;
}

#yaml-title {
    height: 1;
    padding: 0 1;
    background: #282c34;
    color: #abb2bf;
    content-align: left middle;
    border-bottom: solid #3e4451;
}

#yaml-text {
    height: 1fr;
    border: none;
    background: transparent;
    padding: 1;
}

/* footer bar */
#footer-bar {
    height: 3;
    background: #282c34;
    border-top: solid #3e4451;
    padding: 0 1;
}

#footer-keys {
    width: 1fr;
    content-align: left middle;
    color: #5c6370;
}

#footer-mode {
    width: auto;
    background: #3e4451;
    color: #abb2bf;
    padding: 0 2;
    border-left: thick #e5a23e;
    content-align: center middle;
}
