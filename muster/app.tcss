/* ================================================================
   muster TCSS — Warm orange accent with round corners
   ================================================================ */

Screen {
    background: #0a0a0e;
}

#body {
    height: 100%;
    padding: 2 3;
}

/* service tree */
#service-tree {
    width: 28%;
    height: 100%;
    border: round #4a4a5c;
    background: #111118;
    padding: 1 1;
    margin: 0 3 0 0;
}

#service-tree:focus {
    border: round #f97316;
}

Tree {
    background: transparent;
    padding: 0 1;
}

Tree > .tree--cursor {
    background: #2d1a0f;
    text-style: bold;
}

Tree > .tree--highlight {
    text-style: none;
}

.tree--guides {
    color: #2a2a35;
}

#right-panel {
    width: 72%;
    height: 100%;
}

/* status bar */
#status-bar {
    height: 1;
    background: #0a0a0e;
    color: #6e7681;
    padding: 0 1;
    border: none;
}

/* detail */
#detail {
    height: 35%;
    border: round #4a4a5c;
    background: #14141c;
    padding: 1;
    margin: 0 0 3 0;
}

#detail-container {
    height: 100%;
}

#detail-content {
    height: 1fr;
}

/* buttons */
#action-buttons {
    display: none;
    height: auto;
    padding: 0;
}

#action-buttons Button {
    width: auto;
    height: 3;
    padding: 0 2;
    margin: 0 1;
    border: round #4a4a5c;
    background: #1a1a22;
    color: #858585;
    content-align: center middle;
}

#action-buttons Button:hover {
    background: #24242c;
    border: round #f97316;
}

#action-buttons Button#btn-start {
    color: #4ec9b0;
}

#action-buttons Button#btn-stop {
    color: #f44747;
}

#action-buttons Button#btn-restart {
    color: #dcdcaa;
}

#action-buttons Button:disabled {
    color: #33333a;
    background: #14141c;
    border: round #2d2d3a;
}

/* log */
#log {
    height: 1fr;
    border: round #4a4a5c;
    background: #171720;
    padding: 1;
    margin: 3 0 0 0;
}

TextArea {
    background: transparent;
    border: none;
}

TextArea:focus {
    border: none;
}

/* footer */
Footer {
    background: #0a0a0e;
    color: #52525b;
    border: none;
}

Footer > .footer--highlight {
    background: #1f1f25;
    color: #f97316;
}

Footer > .footer--highlight-key {
    color: #fdba74;
}

Footer > .footer--key {
    color: #6e7681;
}
